{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm install && npm run build"
  },
  "healthcheck": {
    "path": "/health",
    "port": 8080,
    "timeout": 10,
    "interval": 10,
    "retries": 10
  },
  "deploy": {
    "startCommand": "NODE_ENV=production node dist/server.cjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

